{
  "name": "nice-aos",
  "version": "0.52.0",
  "description": "nice-aos：把代码仓库扫成可查询的本体快照。核心命令 ask / output / serve，体检用 check。覆盖 React、Vue、Flutter、Go、Python、PHP、Kotlin 与油猴脚本，以及数据库、部署、服务和规划蓝图。",
  "type": "module",
  "bin": {
    "nice-aos": "src/cli/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "code-ontology",
    "react",
    "vue",
    "flutter",
    "dart",
    "go",
    "golang",
    "typescript",
    "static-analysis",
    "code-map",
    "dependency-graph",
    "cli",
    "ai-agent",
    "mysql",
    "database",
    "schema",
    "migration",
    "er-diagram",
    "flyway",
    "deployment",
    "docker",
    "docker-compose",
    "kubernetes",
    "k8s",
    "nginx",
    "devops",
    "architecture-diagram",
    "canvas",
    "html-canvas",
    "java",
    "backend",
    "spring",
    "service-blueprint",
    "asdm-aos",
    "planning",
    "prd",
    "product-planning",
    "roadmap",
    "feature",
    "blueprint",
    "planning-blueprint",
    "python",
    "fastapi",
    "flask",
    "django",
    "chaquopy",
    "php",
    "kotlin",
    "zentaopms",
    "android",
    "trait",
    "shell",
    "bash",
    "powershell",
    "ps1",
    "cmake",
    "pkgbuild",
    "arch-linux",
    "nix",
    "flake",
    "context-docs",
    "docs-viewer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SmallRob/nice-aos.git",
    "directory": "nice-aos"
  },
  "scripts": {
    "aos": "node src/cli/index.js --snapshot-dir ../.codebuddy/skills/nice-aos-skill/data",
    "aos:build": "node src/cli/index.js --snapshot-dir ../.codebuddy/skills/nice-aos-skill/data action refreshRepo --params \"{\\\"repoPath\\\":\\\"..\\\",\\\"roots\\\":[\\\"src\\\",\\\"nicekit/src\\\",\\\"nice-steam/src\\\"]}\"",
    "aos:report": "node src/cli/index.js --snapshot-dir ../.codebuddy/skills/nice-aos-skill/data export --format markdown --output ../.codebuddy/skills/nice-aos-skill/data/report.md",
    "aos:self": "node src/cli/index.js action refreshRepo --params \"{\\\"repoPath\\\":\\\".\\\",\\\"roots\\\":[\\\"src\\\"]}\"",
    "aos:self:report": "node src/cli/index.js export --format markdown --output .nice-aos/data/self-report.md",
    "test": "node --test \"test/*.test.mjs\" \"test/storage/*.test.mjs\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^11.1.0",
    "typescript": "^5.8.0",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.0"
  },
  "bundledDependencies": [
    "@modelcontextprotocol/sdk",
    "commander",
    "typescript",
    "yaml"
  ],
  "files": [
    "src/**",
    "skills/**/SKILL.md",
    "skills/**/assets/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
