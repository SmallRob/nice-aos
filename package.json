{
  "name": "nice-aos",
  "version": "0.20.0",
  "description": "nice-aos —— 通用前端代码本体分析与数据库脚本分析 CLI（React / Vue 2+3 / Flutter / Go / 油猴脚本 / MySQL 迁移脚本）：扫描 React/TypeScript、Vue 2 Options API / Vue 3 SFC、Flutter/Dart、Go 与 Tampermonkey UserScript 源码生成结构化本体快照；同时支持 MySQL 迁移脚本目录分析（Flyway 标准 / Sprint 非标准布局、多数据库、mysqldump 兼容），产出数据库模型（表/列/主键/外键/索引/迁移历史/领域分组/模式特征）和自包含数据蓝图 dataoverview HTML（SVG ER 关系图），支持增量扫描；供 AI agent 与开发者毫秒级查询",
  "type": "module",
  "bin": {
    "nice-aos": "src/cli/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "code-ontology",
    "react",
    "vue",
    "flutter",
    "dart",
    "go",
    "golang",
    "typescript",
    "static-analysis",
    "code-map",
    "dependency-graph",
    "cli",
    "ai-agent",
    "mysql",
    "database",
    "schema",
    "migration",
    "er-diagram",
    "flyway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SmallRob/nice-aos.git",
    "directory": "nice-aos"
  },
  "scripts": {
    "aos": "node src/cli/index.js --snapshot-dir ../.codebuddy/skills/nice-aos-skill/data",
    "aos:build": "node src/cli/index.js --snapshot-dir ../.codebuddy/skills/nice-aos-skill/data action refreshRepo --params \"{\\\"repoPath\\\":\\\"..\\\",\\\"roots\\\":[\\\"src\\\",\\\"nicekit/src\\\",\\\"nice-steam/src\\\"]}\"",
    "aos:report": "node src/cli/index.js --snapshot-dir ../.codebuddy/skills/nice-aos-skill/data export --format markdown --output ../.codebuddy/skills/nice-aos-skill/data/report.md",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "commander": "^11.1.0",
    "typescript": "^5.8.0"
  },
  "files": [
    "src/**",
    "skills/**/SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
